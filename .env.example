# ─────────────────────────────────────────────────────────────
# PostgreSQL Settings
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=inventory_db

# ─────────────────────────────────────────────────────────────
# Backend Settings
# ─────────────────────────────────────────────────────────────
# Used internally by docker-compose (auto-set from POSTGRES_* vars)
DATABASE_URL=postgresql://postgres:changeme_in_production@db:5432/inventory_db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─────────────────────────────────────────────────────────────
# Frontend Settings
# ─────────────────────────────────────────────────────────────
# URL of the backend API (used at build time by Vite)
# For local development: http://localhost:8000
# For production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
